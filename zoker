def _normalize_phone(ph) -> str:
    if ph is None: return "—"
    s = str(ph).strip()
    bad_words = {"unknown", "none", "null", "n/a", "na", "no number", "no phone",
                 "not available", "unavailable", "undefined", "invalid", "not found",
                 "—", "-", "–", "", "0", "00"}
    if not s or s.lower() in bad_words: return "—"
    digits = re.sub(r"[^\d+]", "", s)
    if not digits or digits in ("+", ""): return "—"
    pure = digits.lstrip("+")
    if not pure.isdigit(): return "—"
    if len(pure) == 10 and pure[0] in "6789": return f"+91{pure}"
    if len(pure) == 12 and pure.startswith("91"): return f"+{pure}"
    if len(pure) >= 10: return f"+{pure}"
    return "—"

def _has_valid_phone(info: dict) -> bool:
    if not isinstance(info, dict): return False
    raw = (info.get("phone") or info.get("mobNo") or info.get("phoneNumber")
        or info.get("mobile") or info.get("Mobile") or info.get("phone_number")
        or info.get("PhoneNumber") or info.get("contact") or info.get("number")
        or info.get("msisdn") or "")
    if not raw: return False
    norm = _normalize_phone(raw)
    if norm == "—": return False
    if len(re.sub(r"\D", "", norm)) < 10: return False
    return True

def _extract_phone(info: dict) -> str:
    if not isinstance(info, dict): return "—"
    keys = ("mobNo", "phoneNumber", "phone", "mobile", "Mobile",
            "phone_number", "PhoneNumber", "contact", "number", "msisdn")
    for k in keys:
        v = info.get(k)
        if v is not None and str(v).strip():
            n = _normalize_phone(v)
            if n != "—": return n
    sims = info.get("sims") or {}
    sim_list = sims if isinstance(sims, list) else list(sims.values())
    for sim in sim_list:
        if not isinstance(sim, dict): continue
        for k in keys:
            v = sim.get(k)
            if v is not None and str(v).strip():
                n = _normalize_phone(v)
                if n != "—": return n
    for k, v in info.items():
        if isinstance(v, dict):
            for kk in keys:
                val = v.get(kk)
                if val is not None and str(val).strip():
                    n = _normalize_phone(val)
                    if n != "—": return n
    return "—"

