    new_exp = base + timedelta(hours=hours)
    if new_exp < now_dt() and hours < 0:
        new_exp = now_dt() - timedelta(seconds=1)
    data["users"][str(uid)]["expires_at"] = new_exp.strftime("%Y-%m-%d %H:%M:%S")
